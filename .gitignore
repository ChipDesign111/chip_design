# Timestamped local work, waveforms and licensed IP
/test/*/runs/
/tools/local/
/model/data/
**/__pycache__/
*.py[cod]
*.vcd
*.wlf
*.fst
*.vvp
**/work/
transcript
vsim_stacktrace.vstf
.venv/
venv/
.pytest_cache/
.env
.env.*
*.pem
*.key
.vscode/
.idea/
.DS_Store
Thumbs.db

# Vivado-generated state and local build products
# Active projects and generated firmware belong in an external FPGA workspace.
/fpga/final_project/
/fpga/firmware/*.hex
/fpga/firmware/*.bin
/fpga/firmware/*.json
/fpga/firmware/suite/
/vivado.jou
/vivado_*.backup.jou
/vivado.log
/vivado_*.backup.log
/.Xil/

/eda/dist/
/test/int8/runs/

# Generated EDA/FPGA run trees and transient logs. Curated evidence under
# eda/results is retained explicitly rather than ignored wholesale.
/eda_runs/
/report/**/build/
/report/**/runs/
/report/**/console.log
/report/**/xrun.log

# Raw post-simulation products are preserved in the reviewed archive and
# report manifests; only small, human-readable evidence logs are tracked.
/eda/results/**/postsim/build/
/eda/results/**/postsim/build_*/
/eda/results/**/postsim/*/simulation.log*
/eda/results/**/postsim/view_export.log*
/eda/results/**/postsim/sdf.log
/eda/results/**/sram_timing/tool.log
