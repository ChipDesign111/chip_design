/report/**/runs/
/report/**/console.log
/report/**/xrun.log
/fpga/versions/**/logs/

# Raw post-simulation products are preserved in the reviewed archive and
# report manifests; only small, human-readable evidence logs are tracked.
/eda/results/**/postsim/build/
/eda/results/**/postsim/build_*/
/eda/results/**/postsim/*/simulation.log*
/eda/results/**/postsim/view_export.log*
/eda/results/**/postsim/sdf.log
/eda/results/**/sram_timing/tool.log
